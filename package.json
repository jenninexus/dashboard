{
  "name": "dashboard",
  "version": "2.0.0",
  "description": "A self-contained, themeable dashboard seed kit. Pick a profile (SEO, finances, health, pets, or your own), drop in JSON, ship a polished single-file dashboard — no build step, no backend.",
  "type": "module",
  "main": "profiles/seo/seo.html",
  "scripts": {
    "open": "start profiles/seo/seo.html",
    "build-dashboard": "node scripts/build-dashboard.mjs",
    "dashboard:update": "node scripts/update-dashboard.mjs",
    "dashboard": "node scripts/wizard/launch.mjs --open",
    "test": "node --test",
    "profiles": "node scripts/build-dashboard.mjs --list",
    "check:public-boundary": "node scripts/check-public-boundary.mjs"
  },
  "keywords": ["dashboard", "analytics", "template", "seo", "finances", "health", "pets", "charts", "self-contained", "starter-kit"],
  "license": "MIT"
}
