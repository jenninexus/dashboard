node_modules/
storage/

# Secrets and local config. This static kit does not require environment variables;
# safe public templates may still use the *.example exception if one is added later.
.env*
!.env.example
!.env.*.example
*.code-workspace
!*.code-workspace.example

# Per-user generated output (your dashboard lives here)
my-dashboard/
_scratch/

# Local execution plans and legacy agent handoffs. Durable public guidance belongs
# in AGENTS.md, README.md, or docs/; these files must never become public history.
Plans/
dev-chat.md
dev-log.yaml

# Private/commercial experiments are never part of this public repository.
# If private work needs commit history, use a separate sibling repo with no remote;
# a local-only branch here is still part of the public repo's pushable history.
_private/
.private/
paid-app/
product-app-private/

# Local QA/build evidence can contain user data or machine-specific paths.
coverage/
test-results/
playwright-report/
.nyc_output/

# Keep only the curated README gallery public. Full breakpoint sweeps are local QA evidence.
docs/screenshots/**
!docs/screenshots/hero/
!docs/screenshots/hero/**

# Local agent scratch (Codex / Claude Code state). The one public exception is the example
# command folder; copy it to .claude/commands/ in your own clone, which stays ignored.
.codex/
.claude/*
!.claude/commands.example/
.agents/

*.log
.DS_Store
Thumbs.db
